# Copy this file to ".env" and fill in ONLY what you need. ".env" is git-ignored (never commit keys).
# No keys are needed for the default offline demo (FakeLLM).

# Which LLM drafts replies and classifies tickets:  fake | openai | groq
LLM_PROVIDER=fake

# --- OpenAI (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Groq Cloud (LLM_PROVIDER=groq)  NOTE: Groq (groq.com), NOT xAI "Grok" ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
