# Copy this file to ".env" and fill in the key for the provider you choose. ".env" is git-ignored (never commit keys).

# Which LLM classifies tickets and drafts replies:  openai | groq
# (if you leave it empty, run_queue.py asks you which one to use)
LLM_PROVIDER=groq

# --- OpenAI (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Groq Cloud (LLM_PROVIDER=groq)  NOTE: Groq (groq.com), NOT xAI "Grok" ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- Web app (FastAPI backend + React UI) ---
# Allow the "Reset demo data" button in the UI (rebuilds the database). Keep 0 anywhere real people use it.
OPSDESK_ENABLE_RESET=1
# Web origin allowed to call the API directly (the Vite dev server). Normally you do not change this.
# OPSDESK_WEB_ORIGIN=http://localhost:5173
